# 服务端专用配置示例。将所选配置填入本机 deploy/.env.stack。
# Groq 免费限额测试，需自行创建 Groq API Key。
MALL_SUPPORT_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
MALL_SUPPORT_MODEL=openai/gpt-oss-20b
MALL_SUPPORT_API_KEY=

# OpenAI 官方 GPT 替换示例，账户须有可用额度。
# MALL_SUPPORT_ENDPOINT=https://api.openai.com/v1/chat/completions
# MALL_SUPPORT_MODEL=gpt-4.1-mini
# MALL_SUPPORT_API_KEY=
