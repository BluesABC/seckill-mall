FROM node:22.20.0-bookworm-slim AS builder
WORKDIR /app
COPY src/web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY src/web/ ./
RUN npm run build
FROM nginx:1.28.0-alpine
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/proxy.conf /etc/nginx/proxy.conf
COPY deploy/nginx/security.conf /etc/nginx/security.conf
COPY --from=builder /app/dist /usr/share/nginx/html
HEALTHCHECK --interval=5s --timeout=3s --retries=20 CMD wget -q -O /dev/null http://127.0.0.1/health/live || exit 1
