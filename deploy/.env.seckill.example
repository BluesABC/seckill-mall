# C++ HTTP component, use after source scripts/env-wsl.sh.
MALL_HTTP_HOST=127.0.0.1
MALL_HTTP_PORT=8083
MALL_HTTP_WORKERS=8
MALL_HTTP_QUEUE=128
MALL_REDIS_HOST=127.0.0.1
MALL_REDIS_PORT=16379
MALL_REDIS_TIMEOUT_MS=1500
MALL_KEY_PREFIX=seckill
MALL_IP_LIMIT=100
MALL_USER_LIMIT=20
MALL_PROOF_LIMIT=5
MALL_MAX_PENDING=10000
# MALL_LUA_DIR defaults to the build's source tree; override for deployment.
