# 仅配置模板，无真实密钥；复制为.gitignore忽略的deploy/.env.wechat。
# 商户平台开通Native、绑定AppID后填写。不要把私钥/APIv3值写进此文件。
WECHAT_MCH_ID=replace_with_merchant_id
WECHAT_APP_ID=replace_with_bound_appid
WECHAT_MERCHANT_SERIAL=replace_with_merchant_certificate_serial
WECHAT_PAY_PUBLIC_KEY_ID=replace_with_wechat_public_key_id
WECHAT_NOTIFY_URL=https://your-payment-domain.example/api/payments/wechat/notify
# WSL/Linux绝对路径；目录内3个文件名见compose.wechat.yml。
WECHAT_SECRET_DIR=/absolute/path/to/private/wechat
