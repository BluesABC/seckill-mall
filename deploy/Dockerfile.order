FROM maven:3.9.11-eclipse-temurin-21 AS builder
WORKDIR /project
COPY src/order/pom.xml src/order/pom.xml
COPY src/order/src src/order/src
RUN --mount=type=cache,target=/root/.m2 mvn -B -Dmaven.wagon.http.retryHandler.count=3 -f src/order/pom.xml verify
FROM eclipse-temurin:21-jre-jammy
ARG UBUNTU_MIRROR=https://archive.ubuntu.com/ubuntu
RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g;s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" /etc/apt/sources.list && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* && useradd -m -u 10001 mall
WORKDIR /app
COPY --from=builder /project/src/order/target/order-service-0.1.0-SNAPSHOT.jar /app/order.jar
COPY src/seckill/lua /app/lua
USER 10001
ENV ORDER_BIND=0.0.0.0 ORDER_PORT=8082 MALL_LUA_DIRECTORY=/app/lua
ENTRYPOINT ["java", "-jar", "/app/order.jar"]
