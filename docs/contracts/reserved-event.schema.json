{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seckill-mall:reserved-event:1",
  "title": "SeckillReservedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","eventType","eventId","reservationId","requestId","userId","activityId","skuId","epoch","quantity","priceFen","createdAtMs","traceId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventType": {"const": "SECKILL_RESERVED"},
    "eventId": {"type":"string","format":"uuid"},
    "reservationId": {"type":"string","format":"uuid"},
    "requestId": {"type":"string","format":"uuid"},
    "traceId": {"type":"string","pattern":"^[A-Za-z0-9-]{1,64}$"},
    "userId": {"$ref":"#/$defs/positiveDecimal"},
    "activityId": {"$ref":"#/$defs/positiveDecimal"},
    "skuId": {"$ref":"#/$defs/positiveDecimal"},
    "epoch": {"$ref":"#/$defs/positiveDecimal"},
    "priceFen": {"$ref":"#/$defs/positiveDecimal"},
    "createdAtMs": {"$ref":"#/$defs/positiveDecimal"},
    "quantity": {"const":1}
  },
  "$defs": {"positiveDecimal":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"}}
}
